{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parcel-forge:repair-proposal:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_run",
    "source_spec_sha256",
    "attempt",
    "changes"
  ],
  "properties": {
    "schema": {
      "const": "parcel_forge.repair_proposal/2"
    },
    "source_run": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "from",
          "to"
        ],
        "properties": {
          "path": {
            "const": "/geometry/fault"
          },
          "from": {
            "enum": [
              "sealed_lid",
              "missing_bottom"
            ]
          },
          "to": {
            "const": "none"
          }
        }
      }
    }
  }
}
