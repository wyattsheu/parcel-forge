#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "A"
{
    def Cube "plate" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI"]
    )
    {
        double size = 1
        def Cube "nested" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            double size = 1
        }
    }
}
