#!/usr/bin/env python3
"""parcel-forge CLI.

Runs on the plain system Python with the standard library only. Subcommands
that need Kit re-launch themselves inside the installed Isaac runtime through
src/parcel_forge/runtime/launcher.py. This CLI never pip-installs or upgrades
anything.

Implemented now (S0/S1):
    pf doctor [--out DIR]
    pf smoke  [--physics-only] [--profile FILE] [--device N] [--timeout SEC]
    pf box    (--case <case-id> | --all | --dt-sweep) [--profile FILE] [--device N] [--timeout SEC]
    pf build  --case <case-id>            schema check, then author asset.usda
    pf verify (--case <case-id> | --all)  build + static USD validation (no GPU)
    pf view   [--run <run-id>] [--scene asset.usda|scene_final.usda] [--hold-seconds N]
              [--ui]        stream the full editor UI, not just the viewport
              [--replace]   stop an existing parcel-forge viewer and take over
    pf view --stop          stop the parcel-forge viewer holding the WebRTC ports
    pf upstream-resume-check --run <run-id>
    pf upstream-focused-check --run <run-id>
    pf actor-boundary-check
    pf repair-link-check --proposal-run RUN-ID --validation-run RUN-ID
    pf proposal-exchange prepare --source-run RUN-ID
    pf proposal-exchange check --prompt-run RUN-ID --response FILE
    pf repair-execute --proposal-run RUN-ID [--device N]
    pf repair-proposal --source-run RUN-ID --proposal FILE
    pf video --run <S2-run-id>
    pf upstream-check --run <run-id>
    pf mass-readback [--device N] [--timeout SEC]
    pf dynamic-drop [--device N] [--timeout SEC]
    pf placement-grid [--physics-only] [--device N] [--timeout SEC]
    pf sidewall [--physics-only] [--device N] [--timeout SEC]
    pf runs   [--last N]

Specified in the handbook but NOT implemented yet (they exit 4, never pretend):
    pf build | validate | simulate | render | verify | batch
"""

import os
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(REPO_ROOT, "src"))

from parcel_forge import EXIT_INSUFFICIENT_EVIDENCE  # noqa: E402

NOT_IMPLEMENTED = {
    "simulate": "S4", "render": "S4", "batch": "S6",
}


def usage() -> int:
    print(__doc__)
    return 2


def cmd_runs(argv) -> int:
    n = int(argv[argv.index("--last") + 1]) if "--last" in argv else 10
    runs_dir = os.path.join(REPO_ROOT, "runs")
    entries = sorted(d for d in os.listdir(runs_dir) if os.path.isdir(os.path.join(runs_dir, d)))
    import json
    for d in entries[-n:]:
        mpath = os.path.join(runs_dir, d, "manifest.json")
        if os.path.isfile(mpath):
            with open(mpath, encoding="utf-8") as fh:
                m = json.load(fh)
            print(f"{d}  stage={m.get('stage')}  exit={m.get('exit_code')}  backend={m.get('backend')}")
        else:
            print(f"{d}  (no manifest)")
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        return usage()
    cmd, argv = sys.argv[1], sys.argv[2:]

    if cmd in ("-h", "--help", "help"):
        return usage()
    if cmd == "doctor":
        from parcel_forge.doctor import main as doctor_main
        return doctor_main(argv)
    if cmd == "smoke":
        from parcel_forge.smoke_host import main as smoke_main
        return smoke_main(argv)
    if cmd in ("build", "verify", "validate"):
        from parcel_forge.build_host import build_case, main as verify_main
        if cmd == "build":
            case = argv[argv.index("--case") + 1] if "--case" in argv else None
            if not case:
                print("usage: pf build --case <case-id>")
                return 3
            code, run_dir, _m = build_case(case)
            print(f"run: {run_dir}")
            return code
        return verify_main(argv)
    if cmd == "box":
        from parcel_forge.box_host import main as box_main
        return box_main(argv)
    if cmd == "upstream-resume-check":
        from parcel_forge.upstream_resume_check import main as resume_main
        return resume_main(argv)
    if cmd == "upstream-focused-check":
        from parcel_forge.focused_validation_host import main as focused_main
        return focused_main(argv)
    if cmd == "actor-boundary-check":
        from parcel_forge.actor_boundary_check import main as boundary_main
        return boundary_main(argv)
    if cmd == "repair-link-check":
        from parcel_forge.repair_link import main as link_main
        return link_main(argv)
    if cmd == "proposal-exchange":
        from parcel_forge.proposal_exchange import main as exchange_main
        return exchange_main(argv)
    if cmd == "repair-execute":
        from parcel_forge.repair_execute import main as execute_main
        return execute_main(argv)
    if cmd == "repair-proposal":
        from parcel_forge.repair_guard import main as repair_main
        return repair_main(argv)
    if cmd == "video":
        from parcel_forge.video_host import main as video_main
        return video_main(argv)
    if cmd == "upstream-check":
        from parcel_forge.upstream_bridge import main as upstream_main
        return upstream_main(argv)
    if cmd == "mass-readback":
        from parcel_forge.mass_readback_host import main as mass_readback_main
        return mass_readback_main(argv)
    if cmd == "dynamic-drop":
        from parcel_forge.dynamic_drop_host import main as dynamic_drop_main
        return dynamic_drop_main(argv)
    if cmd == "placement-grid":
        from parcel_forge.placement_grid_host import main as placement_grid_main
        return placement_grid_main(argv)
    if cmd == "sidewall":
        from parcel_forge.sidewall_host import main as sidewall_main
        return sidewall_main(argv)
    if cmd == "view":
        from parcel_forge.view_host import main as view_main
        return view_main(argv)
    if cmd == "runs":
        return cmd_runs(argv)
    if cmd in NOT_IMPLEMENTED:
        print(f"`pf {cmd}` is specified in IsaacSim_Asset_Workflow_Handbook.md but is not "
              f"implemented yet (planned for stage {NOT_IMPLEMENTED[cmd]}).")
        print(f"Exiting {EXIT_INSUFFICIENT_EVIDENCE} (insufficient evidence) rather than pretending to pass.")
        return EXIT_INSUFFICIENT_EVIDENCE
    print(f"unknown subcommand: {cmd}")
    return usage()


if __name__ == "__main__":
    sys.exit(main())
