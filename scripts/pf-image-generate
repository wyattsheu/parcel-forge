#!/usr/bin/env python3
"""Explicit single-attempt TripoSR execution from a validated image intake."""
import argparse,json,sys,os,subprocess,time
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'src'))
from parcel_forge.evidence import make_unique_run_dir,write_json,sha256_file
from parcel_forge.workflow.image_intake import TRIPOSR_PIN
from parcel_forge.workflow.preflight import evaluate
from parcel_forge.repair_execute import available_gpu
p=argparse.ArgumentParser();p.add_argument('--run',type=Path,required=True);p.add_argument('--component-policy',choices=['keep','largest'],default='keep');args=p.parse_args();out=Path(make_unique_run_dir('image_generation'));result={'status':'fail','generation':'not_tested','physics':'not_tested','render':'not_tested','human_webrtc':'not_tested'};t=time.monotonic();code=1
try:
 source=args.run.resolve()
 if source.parent!=ROOT/'runs':raise ValueError('intake must be immediate project run')
 req=json.loads((source/'request.json').read_text());bundle=json.loads((source/'bundle.json').read_text())
 if json.loads((source/'result.json').read_text()).get('status')!='prepared' or req['provider']['backend']!='TRIPOSR' or req['provider']['commit']!=TRIPOSR_PIN:raise ValueError('prepared TRIPOSR request required')
 if req['image']['path']!='input/drill.png' or sha256_file(str(source/'input/drill.png'))!=req['image']['sha256'] or sha256_file(str(source/'bundle.json'))!=req['bundle_sha256']:raise ValueError('intake input hash mismatch')
 caps=json.loads((ROOT/'contracts/workflow/capabilities.json').read_text())['capabilities'];tasks=json.loads((ROOT/'contracts/workflow/task_requirements.json').read_text())['tasks'];gate=evaluate(bundle,caps,tasks);write_json(str(out/'preflight.json'),gate)
 if gate['status']!='ready_for_planning':raise ValueError('workflow preflight no longer ready')
 head=subprocess.run(['git','-C',str(ROOT/'external/TripoSR'),'rev-parse','HEAD'],capture_output=True,text=True,check=True).stdout.strip()
 dirty=subprocess.run(['git','-C',str(ROOT/'external/TripoSR'),'status','--porcelain','--untracked-files=no'],capture_output=True,text=True,check=True).stdout.strip()
 if head!=TRIPOSR_PIN or dirty:raise ValueError('provider checkout pin mismatch or modified')
 inventory,ready=available_gpu(0);write_json(str(out/'gpu_inventory.json'),{'free_mib':inventory,'selected':0})
 if not ready:result['status']='blocked';write_json(str(out/'blocked.json'),{'reason':'GPU0 needs 8000 MiB free'});raise ValueError('GPU unavailable')
 config=json.loads((ROOT/'config/triposr_provider.json').read_text());model=ROOT/config['model_path'];env_python=ROOT/'.venvs/triposr/bin/python'
 for name,expected in config['model_files_sha256'].items():
  if sha256_file(str(model/name))!=expected:raise ValueError('model hash mismatch: '+name)
 if not env_python.is_file():raise ValueError('isolated backend missing')
 (out/'input').mkdir();(out/'input/drill.png').write_bytes((source/'input/drill.png').read_bytes());(out/'bundle.json').write_bytes((source/'bundle.json').read_bytes());write_json(str(out/'request.json'),req)
 env=os.environ.copy();env['PYTHONPATH']=str(ROOT/'src');env.update(CUDA_VISIBLE_DEVICES='0',HF_HOME=str(ROOT/'.venvs/huggingface'),U2NET_HOME=str(ROOT/'.venvs/u2net'),OMP_NUM_THREADS='4');cmd=[str(env_python),str(ROOT/'src/parcel_forge/image_triposr.py'),'--input',str(out/'input/drill.png'),'--out',str(out/'provider/raw'),'--model',str(model),'--component-policy',args.component_policy]
 write_json(str(out/'command.json'),{'command':cmd,'source_run':source.name,'source_request_sha256':sha256_file(str(source/'request.json')),'provider_commit':head,'code_sha256':{str(q.relative_to(ROOT)):sha256_file(str(q)) for q in [Path(__file__),ROOT/'src/parcel_forge/image_triposr.py']}})
 print('run:',out,flush=True)
 with (out/'provider.log').open('w') as log:proc=subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT,env=env,timeout=900)
 result['external_exit_code']=proc.returncode
 raw=json.loads((out/'provider/raw/provider_result.json').read_text());result['provider_result']=raw
 from parcel_forge.workflow.image_intake import obj_info
 if proc.returncode or raw.get('generation')!='pass':raise ValueError('provider execution failed; see provider.log')
 result.update(status='pass',generation='pass',source_run=source.name,obj_metrics=obj_info(out/'provider/raw/mesh.obj'),geometry_fidelity='not_tested');code=0
except Exception as e:result['error']=repr(e)
finally:
 result['seconds']=time.monotonic()-t;result['exit_code']=code;write_json(str(out/'result.json'),result)
print(json.dumps({'run':str(out),**result},indent=2));raise SystemExit(code)
