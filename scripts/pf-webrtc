#!/usr/bin/env python3
"""Start the full editor on an exported image asset; never replace an existing viewer."""
import argparse,json,re,subprocess,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'src'))
from parcel_forge.evidence import make_unique_run_dir,write_json
from parcel_forge.envprobe import load_isaac_env
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--scene',type=Path,default=ROOT/'exports/image_drill_appearance_v2/scene.usda')
p.add_argument('--public-ip',default='140.113.203.85');p.add_argument('--device',default='0');p.add_argument('--check',action='store_true',help='check only; do not start Isaac')
a=p.parse_args();out=Path(make_unique_run_dir('webrtc_start'));result={'status':'blocked','human_webrtc':'not_tested','livestream_execution':'not_tested'};code=4
try:
 cfg=load_isaac_env();scene=a.scene.absolute()
 if not scene.is_file():raise ValueError('scene file missing')
 if not Path(cfg['isaac_python']).is_file() or not Path(cfg['isaac_cwd']).is_dir():raise ValueError('bind installed Isaac with pf-machine first')
 sockets=subprocess.run(['ss','-lntu'],capture_output=True,text=True,check=True).stdout
 if any(re.search(r':'+str(port)+r'\s',sockets) for port in (49100,47998)):raise ValueError('existing WebRTC ports are occupied; use that viewer, do not replace it')
 gpu=subprocess.run(['nvidia-smi','--query-gpu=index,memory.free','--format=csv,noheader,nounits'],capture_output=True,text=True,check=True)
 free={row.split(',')[0].strip():int(row.split(',')[1]) for row in gpu.stdout.splitlines()}
 write_json(str(out/'gpu_inventory.json'),{'free_mib':free,'selected':a.device})
 if free.get(a.device,0)<8000:raise ValueError('selected GPU needs at least 8000 MiB free')
 cmd=[str(ROOT/'scripts/pf'),'view','--run',str(scene),'--ui','--paused','--device',a.device,'--public-ip',a.public_ip]
 write_json(str(out/'command.json'),{'command':cmd});result.update(scene=str(scene),command=cmd)
 if a.check:result['status']='preflight_ready';code=0
 else:
  with (out/'runtime.log').open('w') as log:
   proc=subprocess.Popen(cmd,cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
  result.update(status='started_not_ready',pid=proc.pid,log=str(out/'runtime.log'),livestream_execution='unknown');code=0
except Exception as e:
 result['reason']=str(e);write_json(str(out/'blocked.json'),{'reason':str(e)})
result['exit_code']=code;write_json(str(out/'result.json'),result)
print(json.dumps({'run':str(out),**result},indent=2))
if code==0:
 print('WebRTC client: server '+a.public_ip+', signaling 49100, stream 47998.')
 if not a.check:print('Wait for [VIEW] READY in runtime log before connecting; initial timeline is stopped.')
sys.exit(code)
