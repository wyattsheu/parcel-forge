#!/usr/bin/env python3
"""Single carton-and-keyboard qualification; does not touch existing WebRTC."""
import sys,json
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'src'))
from parcel_forge.evidence import make_unique_run_dir,write_json,sha256_file
from parcel_forge.repair_execute import available_gpu
from parcel_forge.runtime.launcher import IsaacLauncher
out=Path(make_unique_run_dir('keyboard_package'));inventory,ready=available_gpu(0)
write_json(str(out/'gpu_inventory.json'),{'free_mib':inventory,'selected':0})
if not ready:write_json(str(out/'blocked.json'),{'reason':'GPU0 requires 8000 MiB free'});print(out);sys.exit(4)
script=ROOT/'src/parcel_forge/keyboard_package.py'
write_json(str(out/'code_hashes.json'),{str(p.relative_to(ROOT)):sha256_file(str(p)) for p in [script,Path(__file__),ROOT/'src/parcel_forge/carton_author.py',ROOT/'src/parcel_forge/crease_model.py',ROOT/'src/parcel_forge/carton_live.py']})
print('run:',out,flush=True)
result=IsaacLauncher().run(str(script),['--out',str(out)],str(out/'runtime.log'),timeout=600)
write_json(str(out/'launch.json'),result)
if (out/'result.json').exists():print((out/'result.json').read_text())
else:print('Missing result; inspect runtime.log')
sys.exit(0 if result['external_exit_code']==0 and (out/'result.json').exists() and json.loads((out/'result.json').read_text())['status']=='pass' else 1)
