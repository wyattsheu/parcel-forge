#!/usr/bin/env python3
"""Bind an already-installed pip Isaac interpreter and probe APIs without starting Kit."""
import argparse,json,subprocess,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'src'))
from parcel_forge.evidence import make_unique_run_dir,write_json
from parcel_forge.envprobe import load_isaac_env
p=argparse.ArgumentParser();p.add_argument('--python',type=Path);p.add_argument('--cwd',type=Path);p.add_argument('--device',default='0');p.add_argument('--write-local',action='store_true');a=p.parse_args()
out=Path(make_unique_run_dir('machine_probe'));result={'status':'fail','physics':'not_tested','cross_machine':'not_tested'};code=1
try:
 cfg=load_isaac_env()
 if a.python:
  # Keep venv symlink spelling: resolving it would lose the venv prefix.
  cfg['isaac_python']=str(a.python.absolute())
  cfg['isaac_cwd']=str(a.cwd.absolute() if a.cwd else a.python.absolute().parent.parent)
 cfg['default_cuda_visible_devices']=a.device
 if not Path(cfg['isaac_python']).is_file() or not Path(cfg['isaac_cwd']).is_dir():raise ValueError('installed interpreter/cwd missing; provide --python and --cwd')
 snippet="""import json,sys,importlib.metadata as m
from pathlib import Path
try: version=m.version('isaacsim'); base=Path(m.distribution('isaacsim').locate_file('isaacsim'))
except m.PackageNotFoundError: version='unknown'; base=Path(sys.prefix)/'missing'
site=next((x for x in sys.path if x.endswith('site-packages')), '')
preload=Path(site)/'nvidia/cuda_runtime/lib/libcudart.so.12'
files={'simulation_manager':base/'exts/isaacsim.core.simulation_manager/isaacsim/core/simulation_manager/__init__.py','experimental_prims':base/'exts/isaacsim.core.experimental.prims/isaacsim/core/experimental/prims/__init__.py'}
print(json.dumps({'version':version,'python':sys.version.split()[0],'site_packages':site,'ld_preload':str(preload) if preload.is_file() else None,'api_files':{k:p.is_file() for k,p in files.items()}}))
"""
 proc=subprocess.run([cfg['isaac_python'],'-c',snippet],capture_output=True,text=True,timeout=60)
 (out/'probe.log').write_text(proc.stdout+proc.stderr)
 if proc.returncode:raise ValueError('metadata probe failed')
 measured=json.loads(proc.stdout.splitlines()[-1]);write_json(str(out/'inventory.json'),measured)
 cfg['site_packages']=measured['site_packages'];cfg['ld_preload']=measured['ld_preload']
 result.update(status='metadata_checked',version=measured['version'],api_files=measured['api_files'],api_compatibility='candidate' if all(measured['api_files'].values()) else 'unsupported_or_unknown',reference_version='6.0.1.0')
 if a.write_local:
  local=ROOT/'config/isaac_env.local.json'
  if local.exists():raise ValueError('local config exists; preserve it, edit deliberately')
  write_json(str(local),cfg);result['local_config']=str(local)
 code=0 if all(measured['api_files'].values()) else 3
except Exception as e:result['error']=str(e)
result['exit_code']=code;write_json(str(out/'result.json'),result);print(json.dumps({'run':str(out),**result},indent=2));sys.exit(code)
