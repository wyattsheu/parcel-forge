#!/usr/bin/env python3
"""Package a carton run for someone else: the USD, its parameters, and what the USD cannot carry."""
import argparse,json,shutil,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parent.parent;sys.path.insert(0,str(ROOT/'src'))
from parcel_forge.evidence import make_unique_run_dir,write_json,sha256_file
from parcel_forge.runtime.launcher import IsaacLauncher
from parcel_forge.repair_execute import available_gpu
from parcel_forge.carton_feel import grab_force_table

CONTROLLER=['crease_model.py','carton_live.py','carton_lifecycle.py','carton_force_probe.py','carton_feel.py','carton_mouse_diagnostic.py','__init__.py']
parser=argparse.ArgumentParser()
parser.add_argument('--run',required=True,help='a runs/ directory holding asset.usda and config.json')
parser.add_argument('--name',default=None,help='package folder name; defaults to the run id')
args=parser.parse_args()
source=(ROOT/'runs'/args.run).resolve()
if source.parent!=ROOT/'runs' or not (source/'asset.usda').exists():raise SystemExit('need a runs/<id> holding asset.usda: '+str(source))
package=ROOT/'exports'/(args.name or args.run)
if package.exists():raise SystemExit('package already exists, pick another --name: '+str(package))
package.mkdir(parents=True)
config=json.loads((source/'config.json').read_text())
shutil.copy2(source/'asset.usda',package/'carton.usda')
shutil.copy2(source/'config.json',package/'config.json')
controller=package/'crease_controller';(controller/'parcel_forge').mkdir(parents=True)
for name in CONTROLLER:shutil.copy2(ROOT/'src/parcel_forge'/name,controller/'parcel_forge'/name)
(controller/'load_in_isaacsim.py').write_text('''"""Paste into the Isaac Sim Script Editor. Save your work and stop the timeline first."""
import sys,asyncio,importlib,omni.usd
from pathlib import Path
HERE=Path(__file__).resolve().parent
sys.path.insert(0,str(HERE))
import parcel_forge
parcel_forge.__path__=[str(HERE/'parcel_forge')]
if parcel_forge.__spec__ is not None:parcel_forge.__spec__.submodule_search_locations=parcel_forge.__path__
importlib.invalidate_caches()

async def _start():
    global pf_live
    if globals().get('pf_live') is not None:
        pf_live.close();pf_live=None
        import gc;gc.collect()
    try:omni.usd.get_context().get_selection().clear_selected_prim_paths()
    except Exception as exc:print('could not clear selection:',exc)
    ok,error=await omni.usd.get_context().open_stage_async(str(HERE.parent/'carton.usda'))
    if not ok:raise RuntimeError(error)
    import json
    from parcel_forge.carton_live import LiveCarton
    pf_live=LiveCarton(json.loads((HERE.parent/'config.json').read_text()))
    pf_live.show_controls()
    print('Press Play. Without this script the creases are elastic and flaps spring back.')

_task=asyncio.ensure_future(_start())
_task.add_done_callback(lambda t:t.exception() and __import__('traceback').print_exception(t.exception()))
''')
write_json(str(package/'manifest.json'),{'source_run':args.run,'files':{str(p.relative_to(package)):sha256_file(str(p)) for p in sorted(package.rglob('*')) if p.is_file()}})
inventory,ready=available_gpu(0)
evidence=Path(make_unique_run_dir('ext1_carton_export'));write_json(str(evidence/'gpu_inventory.json'),{'free_mib':inventory,'selected':0})
if not ready:write_json(str(evidence/'blocked.json'),{'reason':'GPU0 requires 8000MiB free'});print(evidence);sys.exit(4)
check=ROOT/'src/parcel_forge/carton_export_check.py'
result=IsaacLauncher().run(str(check),['--package',str(package)],str(evidence/'runtime.log'),timeout=600)
write_json(str(evidence/'launch.json'),dict(result,package=str(package)))
if not (package/'physics_in_usd.json').exists():print('readback missing, inspect',evidence/'runtime.log');sys.exit(1)
readback=json.loads((package/'physics_in_usd.json').read_text())
(package/'README.md').write_text('''# Corrugated carton with creasing flaps

Generated by parcel-forge from run `%s`. Every number here was measured on this asset,
and every material parameter is an uncalibrated estimate, not a measured board.

## What is in `carton.usda`

%s

The four creases are revolute joints between the box and each flap, with an angular
force drive. Flap angle: **0 shut, 90 straight up, 180 out like a shelf, 270 folded
right down the outside of the wall**. Limits are %s to %s degrees.

## What the USD cannot carry

Opened on its own, this file gives you an articulated box with **elastic** hinges: push
a flap and it springs back to its authored rest angle. Making a fold *permanent* means
moving that rest angle every physics step against a yield rule, and USD has no attribute
for that. Those numbers are in `config.json` and the rule is in `crease_controller/`.

Run `crease_controller/load_in_isaacsim.py` from the Isaac Sim Script Editor to get the
creasing behaviour. Isaac Sim 6.0.1 on the machine this was built on.

## Measured behaviour, with the controller running

- %.2f N at a flap's outer edge starts it opening, which is the crease yield plus the
  flap's own weight; grabbed halfway up the flap it takes twice that.
- Released above the crease yield it stays open, springing back about %.0f degrees.
- Pushed shut again it stays shut.
- Folded right out it reaches 270 and rests at about 269.
- The box %s.

## Not modelled

The panels are rigid. The carton cannot dent, crush, buckle or tear however hard it is
hit; the only thing that deforms is the crease line. Board MD/CD anisotropy is recorded
in `config.json` as material data but is not simulated in this asset.
'''%(args.run,'\n'.join('- '+line for line in readback['in_the_usd']),
     config.get('crease_lower_limit_deg',-5),config.get('crease_upper_limit_deg',270),
     grab_force_table(config)['by_grab_point'][0]['force_n'],
     config['crease_targets']['springback_deg'],
     'stands on the ground and slides at about 0.7 N' if config.get('base_mode')=='free' else 'is fixed to the world'))
write_json(str(package/'manifest.json'),{'source_run':args.run,'isaac_sim':'6.0.1.0','provenance':config.get('provenance'),
                                         'files':{str(p.relative_to(package)):sha256_file(str(p)) for p in sorted(package.rglob('*')) if p.is_file()}})
write_json(str(evidence/'export.json'),{'package':str(package),'readback_exit':result['external_exit_code'],
                                        'joints_in_usd':len(readback['revolute_joints']),
                                        'gains_match_config':all(j.get('matches_config') for j in readback['revolute_joints'])})
print('package:',package);print('evidence:',evidence)
print(json.dumps({'joints_in_usd':len(readback['revolute_joints']),'gains_match_config':all(j.get('matches_config') for j in readback['revolute_joints']),'readback_exit':result['external_exit_code']},indent=2))
sys.exit(0 if result['external_exit_code']==0 else 1)
